Remark "keep running on error"
OnErrorResume

Remark "select COM port to use"
Choice "Select COM port to use", "COM1,COM2,COM3,COM4,COM5,COM6,COM7,COM8,COM9"
SetVar "COMPORT", "<PILLastResult>"

Remark "Block 1: Try 115200 with parity Even,Odd,None"
SetVar "RSSetting", "115200, 8, E, 1"
Connection "/IF=<COMPORT> /BD=115200 /PA=2 /IT=1", "", "WT=5"
IF "OK" GOTO "END_OK"
SetVar "RSSetting", "115200, 8, O, 1"
Connection "/IF=<COMPORT> /BD=115200 /PA=1 /IT=1", "", "WT=5"
IF "OK" GOTO "END_OK"
SetVar "RSSetting", "115200, 8, N, 1"
Connection "/IF=<COMPORT> /BD=115200 /PA=0 /IT=1", "", "WT=5"
IF "OK" GOTO "END_OK"

Remark "Block2: Try 57600 with parity Even,Odd,None"
SetVar "RSSetting", "57600, 8, E, 1"
Connection "/IF=<COMPORT> /BD=57600 /PA=2 /IT=2", "", "WT=5"
IF "OK" GOTO "END_OK"
SetVar "RSSetting", "57600, 8, O, 1"
Connection "/IF=<COMPORT> /BD=57600 /PA=1 /IT=2", "", "WT=5"
IF "OK" GOTO "END_OK"
SetVar "RSSetting", "57600, 8, N, 1"
Connection "/IF=<COMPORT> /BD=57600 /PA=0 /IT=2", "", "WT=5"
IF "OK" GOTO "END_OK"

Remark "Block3: Try 38400 with parity Even,Odd,None"
SetVar "RSSetting", "38400, 8, E, 1"
Connection "/IF=<COMPORT> /BD=38400 /PA=2 /IT=3", "", "WT=5"
IF "OK" GOTO "END_OK"
SetVar "RSSetting", "38400, 8, O, 1"
Connection "/IF=<COMPORT> /BD=38400 /PA=1 /IT=3", "", "WT=5"
IF "OK" GOTO "END_OK"
SetVar "RSSetting", "38400, 8, N, 1"
Connection "/IF=<COMPORT> /BD=38400 /PA=0 /IT=3", "", "WT=5"
IF "OK" GOTO "END_OK"

Remark "Block4: Try 19200 with parity Even,Odd,None"
SetVar "RSSetting", "19200, 8, E, 1"
Connection "/IF=<COMPORT> /BD=19200 /PA=2 /IT=4", "", "WT=5"
IF "OK" GOTO "END_OK"
SetVar "RSSetting", "19200, 8, O, 1"
Connection "/IF=<COMPORT> /BD=19200 /PA=1 /IT=4", "", "WT=5"
IF "OK" GOTO "END_OK"
SetVar "RSSetting", "19200, 8, N, 1"
Connection "/IF=<COMPORT> /BD=19200 /PA=0 /IT=4", "", "WT=5"
IF "OK" GOTO "END_OK"

Remark "Block5: Try 9600 with parity Even,Odd,None"
SetVar "RSSetting", "9600, 8, E, 1"
Connection "/IF=<COMPORT> /BD=9600 /PA=2 /IT=5", "", "WT=5"
IF "OK" GOTO "END_OK"
SetVar "RSSetting", "9600, 8, O, 1"
Connection "/IF=<COMPORT> /BD=9600 /PA=1 /IT=5", "", "WT=5"
IF "OK" GOTO "END_OK"
SetVar "RSSetting", "9600, 8, N, 1"
Connection "/IF=<COMPORT> /BD=9600 /PA=0 /IT=5", "", "WT=5"
IF "OK" GOTO "END_OK"

Label: "END_ERROR"
Remark "No connection found :-("
MessageBox "Error", "Unable to detect serial connection", ":-(", "OK"
GOTO "FINISH"

Label: "END_OK"
Remark "Connection found :-)"
MessageBox "Info", "<RSSetting> -> there was an INA online connection!", ":-)", "OK"
ClearError
GOTO "FINISH"

Label: "FINISH"
Remark "End"

