;
; *** path to the AS help installation, where the "errors.xml" file is located. this file is used to find and display the help for the warning / error number
;
AsHelpPath=C:\BrAutomation\AS47\Help-de\Data\diagnostics_support\errors
;
; *** preset path and file for "open file" dialog
;
LogfilePreset=C:\temp\output.log
;
; *** if SaveResult = True, the tool output is saved in the same path as the logfile, named <Logfile Name>_yyyy-MM-dd-HH-mm-ss_analyzed.txt
;
SaveResult=False
;
; *** if SaveResult = True AND SaveSummaryOnly = True, only the summary portion of the output is saved (in the same path as the logfile, named <Logfile Name>_yyyy-MM-dd-HH-mm-ss_analyzed.txt)
;
SaveSummaryOnly=False
;
; *** if SkipLogfileMessages = True, the logfile entries with type "Message" are only counted, but no details are displayed or saved
;
SkipLogfileMessages=False
;
; *** if ShowLastOnly = True, only the last / latest complete build is shown
;
ShowLastOnly=True
;
;
;