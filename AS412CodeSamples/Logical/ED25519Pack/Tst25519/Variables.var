(* ED25519 testStep values - belongs to the ED25519 flow, not to FileHandling *)
VAR CONSTANT
	TEST_STEP_IDLE : UINT := 0; (* no flow active; select a start step to run one *)
	TEST_STEP_MEMORY_SIGN : UINT := 10; (* start flow 1: sign memory data *)
	TEST_STEP_MEMORY_VERIFY : UINT := 11; (* flow 1: verify the signed memory data *)
	TEST_STEP_CONTENT_SIGN : UINT := 20; (* start flow 2: sign content for file storage *)
	TEST_STEP_CONTENT_STORE : UINT := 21; (* flow 2: write signed content to file *)
	TEST_STEP_CONTENT_LOAD : UINT := 23; (* flow 2: read signed content back from file *)
	TEST_STEP_CONTENT_VERIFY : UINT := 25; (* flow 2: verify the content read from file *)
	TEST_STEP_EXTERNAL_LOAD : UINT := 30; (* start flow 3: read externally signed content *)
	TEST_STEP_EXTERNAL_VERIFY : UINT := 32; (* flow 3: verify with the external public key *)
	TEST_STEP_ERROR : UINT := 99; (* flow stopped on an error; inspect status outputs *)
END_VAR
VAR
	buffer : ARRAY[0..10129] OF USINT; (* binary signature followed by approximately 10 kB of data *)
	dataOut : STRING[10080]; (* verified memory data *)
	contentBufferLoaded : ARRAY[0..24575] OF USINT; (* 24 KiB buffer for signed content files *)
	contentBuffer : ARRAY[0..10240] OF USINT; (* signed content output: source data plus 176-byte marker block *)
	contentLoaded : ARRAY[0..24575] OF USINT; (* 24 KiB destination for verified content *)
	data : STRING[10080]; (* approximately 10 kB source content shared by the signing flows *)
	i : UDINT; (* source-content generation loop index *)
	tmp : STRING[10]; (* temporary decimal text for source-content generation *)
	testStep : UINT; (* select a flow by setting this to its start-step constant *)
	signedMessageLen : UDINT; (* number of bytes produced by SignMemoryData *)
	keyStatus : UINT; (* result of decoding a hexadecimal key *)
	memoryVerificationSucceeded : BOOL; (* result of flow 1; TRUE only for valid memory signature *)
	contentFileVerificationSucceeded : BOOL; (* result of flow 2; TRUE only for valid stored-content signature *)
	externalVerificationSucceeded : BOOL; (* result of flow 3; TRUE only for valid external-file signature *)
	VerifyMemoryData_0 : VerifyMemoryData; (* verifies the binary memory message *)
	SignToContent_0 : SignToContent; (* signs content into the marker-delimited format *)
	EDFileIOHelper_0 : EDFileIOHelper; (* reads or writes a file asynchronously *)
	VerifyFromContent_0 : VerifyFromContent; (* verifies the marker-delimited content format *)
	sPublicKeyFromExtFile : STRING[64]; (* hex public key for the externally signed file *)
	bPrivateKey : ARRAY[0..31] OF USINT; (* decoded 32-byte private seed *)
	bPublicKey : ARRAY[0..31] OF USINT; (* decoded internal public key *)
	bPublicKeyFromExtFile : ARRAY[0..31] OF USINT; (* decoded external public key *)
	sPrivateInternal : STRING[64]; (* 64-character hexadecimal private seed *)
	sPublicInternal : STRING[64]; (* 64-character hexadecimal internal public key *)
	SignMemoryData_0 : SignMemoryData; (* signs the source memory data *)
END_VAR
