VAR CONSTANT
	ed25519_SIGN_BEGIN_MARKER : STRING[24] := '--- BEGIN SIGNATURE ---$n'; (* text prefix before the hexadecimal signature *)
	ed25519_SIGN_END_MARKER : STRING[24] := '$n--- END  SIGNATURE ---$n'; (* text suffix after the hexadecimal signature *)
	ed25519_SIGN_MARKERBLOCK_LEN : USINT := 24 + 128 + 24; (* total marker block size: prefix, signature text, suffix *)
	ed25519_SIGN_MARKER_LEN : USINT := 24; (* byte length of each begin/end marker *)
	ed25519_SIGN_ASCII_LEN : USINT := 128; (* hexadecimal characters encoding the 64-byte signature *)
END_VAR
(* EDFileIOHelper command values *)
VAR CONSTANT
	ED_FH_CMD_NONE : USINT := 0; (* no command / idle *)
	ED_FH_CMD_WRITE_FILE : USINT := 1; (* command: write buffer to file *)
	ED_FH_CMD_READ_FILE : USINT := 2; (* command: read file into buffer *)
	(* EDFileIOHelper state-machine step values *)
	ED_FH_STEP_IDLE : USINT := 0; (* idle: wait for a command *)
	ED_FH_STEP_WRITE_DELETE : USINT := 10; (* writeFile: delete existing file *)
	ED_FH_STEP_WRITE_CREATE : USINT := 20; (* writeFile: create the file *)
	ED_FH_STEP_WRITE_OPEN : USINT := 30; (* writeFile: open the file *)
	ED_FH_STEP_WRITE_WRITE : USINT := 40; (* writeFile: write the buffer *)
	ED_FH_STEP_WRITE_CLOSE : USINT := 50; (* writeFile: close the file *)
	ED_FH_STEP_READ_INFO : USINT := 95; (* readFile: get file info *)
	ED_FH_STEP_READ_CHK_SIZE : USINT := 96; (* readFile: validate file fits into buffer *)
	ED_FH_STEP_READ_OPEN : USINT := 100; (* readFile: open the file *)
	ED_FH_STEP_READ_READ : USINT := 110; (* readFile: read into buffer *)
	ED_FH_STEP_READ_CLOSE : USINT := 120; (* readFile: close the file *)
	ED_FH_STEP_ERROR_CLOSE : USINT := 98; (* error path: close file before bailing out *)
	ED_FH_STEP_ERROR : USINT := 99; (* error happened *)
	ed25519_ERR_FH_DATASIZE : UINT := 55557; (* file-helper transfer length is zero for a write or exceeds buffer capacity *)
	ed25519_ERR_FH_PARAMETER : UINT := 55556; (* required file-helper parameter or buffer pointer is missing *)
	ed25519_ERR_BUFFERSIZE : UINT := 55555; (* supplied buffer cannot hold the requested signed or file data *)
END_VAR
