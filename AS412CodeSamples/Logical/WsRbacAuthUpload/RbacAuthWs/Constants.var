VAR CONSTANT
	rbacauthws_CONST_CSSSTYLE : STRING[500] := '<style> body { width: 100%; height: 100%; } .textStyle { margin: 5px; font-family: Arial, sans-serif; } .buttonStyle { position: relative; width: 90px; height: 35px; margin: 5px; cursor: pointer; } </style>';
	rbacauthws_CONST_MAXFAILEDAUTH : USINT := 5; (*maximum number of consecutive failed authentications until service is blocked for some time*)
END_VAR
